# ---------------------------------------------------------------------------
# Reflog — environment variables
# Copy this file to .env.local and fill in the values.
# .env.local is gitignored. Never commit real keys.
# ---------------------------------------------------------------------------

# GitHub OAuth app credentials.
# Create at: https://github.com/settings/developers -> "New OAuth App"
#   Homepage URL:               http://localhost:3000
#   Authorization callback URL: http://localhost:3000/api/auth/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Secret used to encrypt the session cookie (AES-256-GCM).
# Generate with:  openssl rand -base64 32
AUTH_SECRET=

# Public base URL of this deployment. Used to build the OAuth redirect_uri
# and share links. No trailing slash.
# Local:      http://localhost:3000
# Production: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Added in later milestones (leave blank for now) -----------------------

# Postgres connection string (Neon / Vercel Postgres free tier).
DATABASE_URL=

# Groq API key for the archetype + closing line. https://console.groq.com/keys
# If this is absent or rate-limited, the rule-based archetype takes over, so the
# app works with this left blank.
GROQ_API_KEY=
